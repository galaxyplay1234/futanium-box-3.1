<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    <!-- ~10dp entre os cards -->
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="10dp"
    android:layout_marginBottom="10dp"

    android:backgroundTint="@android:color/white"
    app:cardCornerRadius="16dp"
    app:cardUseCompatPadding="true"
    app:cardElevation="6dp"

    <!-- borda fininha e suave -->
    app:strokeColor="#14000000"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Linha do campeonato -->
        <ImageView
            android:id="@+id/imgChamp"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/tvChamp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Libertadores"
            android:textColor="#222222"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintStart_toEndOf="@id/imgChamp"
            app:layout_constraintTop_toTopOf="@id/imgChamp"
            app:layout_constraintBottom_toBottomOf="@id/imgChamp"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="8dp"/>

        <!-- NOME DO MANDANTE (direita do texto, colado no escudo da ESQ) -->
        <TextView
            android:id="@+id/tvHomeName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Internacional"
            android:textSize="16sp"
            android:textStyle="normal"
            android:textColor="#333333"
            android:maxLines="2"
            android:ellipsize="end"
            android:breakStrategy="balanced"
            android:hyphenationFrequency="none"
            android:gravity="end"
            android:textAlignment="viewEnd"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/imgHome"
            app:layout_constraintTop_toBottomOf="@id/tvChamp"
            android:layout_marginTop="14dp"/>

        <!-- Escudo da casa (à ESQUERDA do miolo) -->
        <ImageView
            android:id="@+id/imgHome"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@null"
            app:layout_constraintStart_toEndOf="@id/tvHomeName"
            app:layout_constraintTop_toTopOf="@id/tvHomeName"
            app:layout_constraintBottom_toBottomOf="@id/tvHomeName"
            android:layout_marginStart="8dp"/>

        <!-- HORA central, fixa -->
        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="21h30"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#000000"
            app:layout_constraintTop_toTopOf="@id/tvHomeName"
            app:layout_constraintBottom_toBottomOf="@id/tvHomeName"
            app:layout_constraintStart_toEndOf="@id/imgHome"
            app:layout_constraintEnd_toStartOf="@id/imgAway"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>

        <!-- Escudo do visitante (à DIREITA do miolo) -->
        <ImageView
            android:id="@+id/imgAway"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@null"
            app:layout_constraintTop_toTopOf="@id/tvTime"
            app:layout_constraintBottom_toBottomOf="@id/tvTime"
            app:layout_constraintEnd_toStartOf="@id/tvAwayName"
            android:layout_marginEnd="8dp"/>

        <!-- NOME DO VISITANTE (colado no escudo da DIR) -->
        <TextView
            android:id="@+id/tvAwayName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Flamengo"
            android:textSize="16sp"
            android:textStyle="normal"
            android:textColor="#333333"
            android:maxLines="2"
            android:ellipsize="end"
            android:breakStrategy="balanced"
            android:hyphenationFrequency="none"
            android:gravity="start"
            android:textAlignment="viewStart"
            app:layout_constraintTop_toTopOf="@id/tvHomeName"
            app:layout_constraintBottom_toBottomOf="@id/tvHomeName"
            app:layout_constraintStart_toEndOf="@id/imgAway"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Botões (aparecem só quando expandir) -->
        <LinearLayout
            android:id="@+id/btnContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tvAwayName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>