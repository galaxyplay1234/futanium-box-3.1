<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="10dp"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="16dp"
    app:cardUseCompatPadding="true"
    app:cardElevation="6dp"
    app:cardBackgroundColor="@android:color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- Linha do campeonato -->
        <ImageView
            android:id="@+id/imgChamp"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/tvChamp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Libertadores"
            android:textSize="15sp"
            android:textColor="#4A4A4A"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@id/imgChamp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/imgChamp"
            app:layout_constraintBottom_toBottomOf="@id/imgChamp"
            android:layout_marginStart="8dp"/>

        <!-- HORA (central FIXA no card) -->
        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="19h30"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#101010"
            app:layout_constraintTop_toBottomOf="@id/tvChamp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="14dp"/>

        <!-- Escudo da casa, à ESQUERDA da hora (fixo) -->
        <ImageView
            android:id="@+id/imgHome"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@null"
            app:layout_constraintEnd_toStartOf="@id/tvTime"
            app:layout_constraintTop_toTopOf="@id/tvTime"
            app:layout_constraintBottom_toBottomOf="@id/tvTime"
            android:layout_marginEnd="12dp"/>

        <!-- Escudo do visitante, à DIREITA da hora (fixo) -->
        <ImageView
            android:id="@+id/imgAway"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@null"
            app:layout_constraintStart_toEndOf="@id/tvTime"
            app:layout_constraintTop_toTopOf="@id/tvTime"
            app:layout_constraintBottom_toBottomOf="@id/tvTime"
            android:layout_marginStart="12dp"/>

        <!-- Nome do time da casa: ocupa espaço entre a borda e o escudo ESQUERDO.
             Pode quebrar linha sem empurrar ícones nem hora. -->
        <TextView
            android:id="@+id/tvHomeName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Juventude"
            android:textSize="16sp"
            android:textStyle="normal"
            android:textColor="#1F1F1F"
            android:maxLines="2"
            android:ellipsize="end"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/imgHome"
            app:layout_constraintTop_toTopOf="@id/tvTime"
            app:layout_constraintBottom_toBottomOf="@id/tvTime"
            android:layout_marginEnd="8dp"/>

        <!-- Nome do visitante: ocupa espaço entre o escudo DIREITO e a borda. -->
        <TextView
            android:id="@+id/tvAwayName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Ceará"
            android:textSize="16sp"
            android:textStyle="normal"
            android:textColor="#1F1F1F"
            android:maxLines="2"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@id/imgAway"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvTime"
            app:layout_constraintBottom_toBottomOf="@id/tvTime"
            android:layout_marginStart="8dp"/>

        <!-- Botões (expansível) -->
        <LinearLayout
            android:id="@+id/btnContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginTop="14dp"
            app:layout_constraintTop_toBottomOf="@id/tvTime"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>