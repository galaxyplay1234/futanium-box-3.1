<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Futanium" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Cores do app -->
        <item name="colorPrimary">@color/bluePrimary</item>
        <item name="colorPrimaryContainer">@color/blueDark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Fundo inicial e barras (sem flash branco/roxo) -->
        <item name="android:windowBackground">@color/startup_bg</item>
        <item name="android:statusBarColor">@color/startup_bg</item>
        <item name="android:navigationBarColor">@color/startup_bg</item>

        <!-- Opcional: força status bar não clara (texto claro) -->
        <item name="android:windowLightStatusBar">false</item>
        <!-- Opcional: tamanho da action bar, embora NoActionBar não use -->
        <item name="actionBarSize">48dp</item>
    </style>
</resources>